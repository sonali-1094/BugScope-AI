# Copy this file to .env and fill in your real values. Never commit .env.

PORT=5000

# Neon PostgreSQL connection string. Keep the real value in the ignored root .env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Shared high-entropy service token for FastAPI -> Express normalized ingestion.
# Generate a value and set it in both the root .env and backend/.env.
BUGSCOPE_INGEST_TOKEN=
# Optional override if FastAPI cannot reach Express at this local address.
BUGSCOPE_INGEST_URL=http://127.0.0.1:5000/internal/normalized-analysis

# GitHub personal access token (classic, "repo" + "read:org" scopes are enough
# for public repos; needed to raise the API rate limit from 60/hr to 5000/hr)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
