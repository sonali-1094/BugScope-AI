# Copy this file to .env and fill in your real values. Never commit .env.

PORT=5000

# MongoDB connection string (local: mongodb://127.0.0.1:27017/bugscope
# or an Atlas SRV string if you use MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/bugscope

# GitHub personal access token (classic, "repo" + "read:org" scopes are enough
# for public repos; needed to raise the API rate limit from 60/hr to 5000/hr)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
